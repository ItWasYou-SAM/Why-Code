    "payload": {
      "number": 1419,
      "title": "Restrict retries to connection errors",
      "author": "tomchristie",
      "merged": true,
      "merged_at": "2024-04-02T06:30:45Z",
      "url": "https://github.com/encode/httpx/pull/1419",
      "body": "This change makes retries opt-in and limits them to connection errors. Because retrying a read or write request can duplicate server side effects, the client must never retry anything except a connect failure.",
      "labels": [
        "enhancement"
      ]
    },
    "content_hash": "bf2002c6c5bcd5d8d168409f4515444735dcd944aa9c3b224b50203896917ca2",
